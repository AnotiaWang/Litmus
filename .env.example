# 复制为 .env 后填写。.env 里有密钥，不要提交到仓库，也不要发给别人。

# ---------- Binance ----------
# demo = Demo Mode（https://demo-api.binance.com，推荐）；testnet = 测试网（https://testnet.binance.vision）
# 程序只允许这两个地址，填其他地址会拒绝启动
BINANCE_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------- 交易对 ----------
SYMBOL=BTCUSDT

# 预算、运行间隔、策略参数（均线、RSI、信号模式、止损）、风控参数和 LLM 开关
# 都在面板右上角的「设置」里调整，改了马上生效，不需要写在这里

# ---------- LLM（OpenAI 兼容接口） ----------
# 三项都填才能使用 LLM；都不填则不使用。填好后可以在面板「设置」里随时开关
# 地址例如 https://api.openai.com/v1 或 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 思考强度（reasoning_effort），只对推理模型有效，可选值以服务商文档为准，
# 如 OpenAI 的 minimal / low / medium / high。留空则不发送，用模型默认值。
# 设置后不再发送 temperature（推理模型大多不支持）
LLM_REASONING_EFFORT=
# 单次请求最多等多少秒（5~120），超时重试 1 次，仍失败就按否决处理。思考强度高时可以调大
LLM_TIMEOUT_SECONDS=30

# ---------- 面板 ----------
# 面板口令（必填）。可以用 `openssl rand -hex 24` 生成一个随机口令
ADMIN_TOKEN=
PORT=8000
